{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "vlx-green", "name": "Voltalux groen", "color": "#059a41" },
				{ "slug": "vlx-green-strong", "name": "Groen (donker)", "color": "#046a2c" },
				{ "slug": "vlx-green-soft", "name": "Groen tint", "color": "#e6f4ec" },
				{ "slug": "vlx-ink", "name": "Zwart", "color": "#0A0B0D" },
				{ "slug": "vlx-ink-2", "name": "Grijs (tekst)", "color": "#33373B" },
				{ "slug": "vlx-muted", "name": "Grijs (licht)", "color": "#6B7075" },
				{ "slug": "vlx-paper", "name": "Papier", "color": "#F5F5F1" },
				{ "slug": "vlx-white", "name": "Wit", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.9rem" },
				{ "slug": "medium", "name": "Normaal", "size": "1.0625rem" },
				{ "slug": "large", "name": "Groot", "size": "1.24rem" },
				{ "slug": "x-large", "name": "Kop", "size": "clamp(1.8rem, 1.3rem + 2vw, 2.85rem)" },
				{ "slug": "xx-large", "name": "Titel", "size": "clamp(2.35rem, 1.6rem + 3vw, 3.9rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "em" ]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "#046a2c" },
				":hover": { "color": { "text": "#0A0B0D" } }
			},
			"button": {
				"color": { "background": "#059a41", "text": "#ffffff" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.5em", "right": "1.5em" } },
				"typography": { "fontWeight": "600" },
				":hover": { "color": { "background": "#04863a", "text": "#ffffff" } },
				":focus": { "color": { "background": "#04863a", "text": "#ffffff" } }
			},
			"h1": { "typography": { "fontWeight": "800", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontWeight": "800", "letterSpacing": "-0.03em" } },
			"h3": { "typography": { "fontWeight": "700", "letterSpacing": "-0.02em" } }
		}
	}
}
